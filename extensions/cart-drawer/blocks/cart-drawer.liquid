{% comment %}
  Cart Drawer — Theme App Extension Block
  Target: body
{% endcomment %}

<div id="tasslelife-cart-drawer-overlay" class="tasslelife-cart-drawer__overlay" aria-hidden="true"></div>

<div
  id="tasslelife-cart-drawer"
  class="tasslelife-cart-drawer tasslelife-cart-drawer--{{ block.settings.position }}"
  role="dialog"
  aria-modal="true"
  aria-label="Shopping cart"
  data-currency="{{ cart.currency.iso_code }}"
  {{ block.shopify_attributes }}
>

  <!-- Header -->
  <div class="tasslelife-cart-drawer__header">
    <h2 class="tasslelife-cart-drawer__title">Your Cart (<span id="tasslelife-cart-drawer-count">0</span>)</h2>
    <button class="tasslelife-cart-drawer__close" data-tasslelife-cart-drawer-close aria-label="Close cart">
      <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <line x1="18" y1="6" x2="6" y2="18"></line><line x1="6" y1="6" x2="18" y2="18"></line>
      </svg>
    </button>
  </div>

  <!-- Announcement bar -->
  {% if block.settings.announcement_text != blank %}
  <div class="tasslelife-cart-drawer__announcement">{{ block.settings.announcement_text }}</div>
  {% endif %}

  <!-- Multi-tier Progress Bar -->
  {% if block.settings.enable_progress_bar and block.settings.tier1_threshold > 0 %}
  <div
    id="tasslelife-cart-drawer-progress"
    class="tasslelife-cart-drawer__progress"
    data-tier1-threshold="{{ block.settings.tier1_threshold }}"
    data-tier1-label="{{ block.settings.tier1_label | escape }}"
    {% if block.settings.tier2_enabled and block.settings.tier2_threshold > 0 %}
    data-tier2-threshold="{{ block.settings.tier2_threshold }}"
    data-tier2-label="{{ block.settings.tier2_label | escape }}"
    {% endif %}
    {% if block.settings.tier3_enabled and block.settings.tier3_threshold > 0 %}
    data-tier3-threshold="{{ block.settings.tier3_threshold }}"
    data-tier3-label="{{ block.settings.tier3_label | escape }}"
    {% endif %}
    {% if block.settings.tier4_enabled and block.settings.tier4_threshold > 0 %}
    data-tier4-threshold="{{ block.settings.tier4_threshold }}"
    data-tier4-label="{{ block.settings.tier4_label | escape }}"
    {% endif %}
  ></div>
  {% endif %}

  <!-- Scrollable body -->
  <div class="tasslelife-cart-drawer__body">

    <!-- Cart Items -->
    <div id="tasslelife-cart-drawer-items" class="tasslelife-cart-drawer__items">
      <div class="tasslelife-cart-drawer__loading"><div class="tasslelife-cart-drawer__spinner"></div></div>
    </div>

    <!-- Upsell -->
    {% if block.settings.enable_upsell %}
    <div id="tasslelife-cart-drawer-upsell" class="tasslelife-cart-drawer__upsell" style="display:none;">
      <h3 class="tasslelife-cart-drawer__upsell-title">You might also like</h3>
      <div id="tasslelife-cart-drawer-upsell-items" class="tasslelife-cart-drawer__upsell-items"></div>
    </div>
    {% endif %}

    <!-- Gift Wrap -->
    {% if block.settings.enable_gift_wrap and block.settings.gift_wrap_variant_id != blank %}
    <div class="tasslelife-cart-drawer__gift-wrap" data-variant-id="{{ block.settings.gift_wrap_variant_id }}">
      <div class="tasslelife-cart-drawer__gift-wrap-inner">
        <div class="tasslelife-cart-drawer__gift-icon-box">
          <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="#e91e63" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="8" width="18" height="14" rx="2" ry="2" fill="#fce4ec" stroke="none"/><rect x="3" y="8" width="18" height="14" rx="2" ry="2"/><line x1="12" y1="8" x2="12" y2="22"/><path d="M12 8H8a2 2 0 0 1-2-2v0a2 2 0 0 1 2-2h4v4z"/><path d="M12 8h4a2 2 0 0 0 2-2v0a2 2 0 0 0-2-2h-4v4z"/></svg>
        </div>
        <div class="tasslelife-cart-drawer__gift-text">
          <p class="tasslelife-cart-drawer__gift-title">{{ block.settings.gift_wrap_label }}</p>
          <p class="tasslelife-cart-drawer__gift-price">{{ block.settings.gift_wrap_price_label }}</p>
        </div>
        <button class="tasslelife-cart-drawer__gift-btn" id="tasslelife-cart-drawer-gift-wrap">+ Add</button>
      </div>
    </div>
    {% endif %}

    <!-- Delivery Date -->
    {% if block.settings.enable_delivery_date %}
    <div class="tasslelife-cart-drawer__section">
      <label class="tasslelife-cart-drawer__section-label" for="tasslelife-cart-drawer-date">
        <span>📅</span> {{ block.settings.delivery_date_label }}
      </label>
      <input
        type="date"
        id="tasslelife-cart-drawer-date"
        class="tasslelife-cart-drawer__date-input"
        data-min-days="{{ block.settings.delivery_date_min_days }}"
        data-max-days="{{ block.settings.delivery_date_max_days }}"
        aria-label="{{ block.settings.delivery_date_label }}"
      >
    </div>
    {% endif %}

    <!-- Handwritten Note -->
    {% if block.settings.enable_order_note %}
    <div class="tasslelife-cart-drawer__section">
      <label class="tasslelife-cart-drawer__section-label" for="tasslelife-cart-drawer-note">
        <span>✏️</span> {{ block.settings.note_label }}
      </label>
      <textarea
        id="tasslelife-cart-drawer-note"
        class="tasslelife-cart-drawer__note-textarea"
        placeholder="{{ block.settings.note_placeholder | escape }}"
        maxlength="500"
        rows="3"
        aria-label="{{ block.settings.note_label }}"
      ></textarea>
      <p class="tasslelife-cart-drawer__note-counter"><span id="tasslelife-cart-drawer-note-count">0</span>/500</p>
    </div>
    {% endif %}

    <!-- Discount Code -->
    {% if block.settings.enable_discount %}
    <div class="tasslelife-cart-drawer__discount-container">
      <div id="tasslelife-cart-drawer-discount-wrapper">
        {% if block.settings.available_discounts != blank %}
        <div
          id="tasslelife-cart-drawer-discount-chips"
          class="tasslelife-cart-drawer__discount-chips"
          data-available="{{ block.settings.available_discounts | escape }}"
        ></div>
        {% endif %}
        <div class="tasslelife-cart-drawer__discount-row" id="tasslelife-cart-drawer-discount-manual">
          <input
            type="text"
            id="tasslelife-cart-drawer-discount-input"
            class="tasslelife-cart-drawer__discount-input"
            placeholder="Discount code"
            autocapitalize="characters"
            autocomplete="off"
            spellcheck="false"
          >
          <button id="tasslelife-cart-drawer-discount-apply" class="tasslelife-cart-drawer__discount-btn">Apply</button>
        </div>
        <p id="tasslelife-cart-drawer-discount-msg" class="tasslelife-cart-drawer__discount-msg"></p>
      </div>
    </div>
    {% endif %}

    <!-- Delivery Timeline -->
    {% if block.settings.enable_delivery_timeline %}
    <div class="ship-timeline" id="tasslelife-cart-drawer-timeline" 
         data-fulfill-min="{{ block.settings.timeline_fulfill_min | default: 1 }}" 
         data-fulfill-max="{{ block.settings.timeline_fulfill_max | default: 2 }}" 
         data-delivery-min="{{ block.settings.timeline_delivery_min | default: 3 }}" 
         data-delivery-max="{{ block.settings.timeline_delivery_max | default: 5 }}">
      
      <h4>Estimate shipping period</h4>
      
      <div class="timeline-steps">
        <div class="step active">
          <span>Ordered</span>
          <small>today</small>
        </div>

        <div class="step active">
          <span>Shipping</span>
          <small id="shipping-days"></small>
        </div>

        <div class="step">
          <span>Delivery</span>
          <small id="delivery-days"></small>
        </div>
      </div>

      <div class="timeline-bar">
        <div class="progress"></div>
      </div>

      <div class="timeline-dates">
        <span id="today"></span>
        <span id="shipping"></span>
        <span id="delivery"></span>
      </div>
    </div>
    {% endif %}

  </div>

  <!-- Footer -->
  <div class="tasslelife-cart-drawer__footer" id="tasslelife-cart-drawer-footer" style="display:none;">
    <div class="tasslelife-cart-drawer__subtotal-row">
      <span class="tasslelife-cart-drawer__subtotal-label"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#666" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="vertical-align: middle; margin-right: 6px;"><rect x="3" y="11" width="18" height="10" rx="2"/><circle cx="12" cy="5" r="2"/><path d="M12 7v4"/><line x1="8" y1="16" x2="8" y2="16"/><line x1="16" y1="16" x2="16" y2="16"/></svg> Estimated total</span>
      <span class="tasslelife-cart-drawer__subtotal-value" id="tasslelife-cart-drawer-subtotal">—</span>
    </div>
    <div class="tasslelife-cart-drawer__actions">
      <a href="/checkout" class="tasslelife-cart-drawer__checkout-btn" id="tasslelife-cart-drawer-checkout">
        <span class="tasslelife-cart-drawer__checkout-text">Checkout</span>
        <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><line x1="5" y1="12" x2="19" y2="12"></line><polyline points="12 5 19 12 12 19"></polyline></svg>
      </a>
    </div>
  </div>

</div>

<style>
  :root {
    --tasslelife-cart-drawer-primary: {{ block.settings.primary_color }};
    --tasslelife-cart-drawer-bg: {{ block.settings.background_color }};
    --tasslelife-cart-drawer-text: {{ block.settings.text_color }};
    --tasslelife-cart-drawer-width: 420px;
  }

  /* container */
  .ship-timeline{
    background:#eef0e6;
    padding:18px;
    border-radius:12px;
    margin: 0 16px 16px;
  }
  
  /* heading */
  .ship-timeline h4{
    margin:0 0 14px;
    font-size:16px;
    font-weight:600;
    color: #111;
  }
  
  /* steps */
  .timeline-steps{
    display:flex;
    justify-content:space-between;
    margin-bottom:6px;
  }
  
  .step{
    text-align:center;
    font-size:13px;
    color:#7a7a7a;
  }
  
  .step span{
    display:block;
    font-weight:600;
  }
  
  .step.active{
    color:#4b6b2f;
  }
  
  /* progress bar */
  .timeline-bar{
    display: block !important;
    position:relative;
    height:6px;
    background:#dcdcdc !important;
    border-radius:10px;
    margin:12px 0;
  }
  
  .timeline-bar .progress {
    display: block !important;
    height: 100% !important;
    width: 50% !important;
    background: #4b6b2f !important;
    border-radius: 10px;
  }
  
  /* dots */
  .timeline-bar::before,
  .timeline-bar::after{
    content:'';
    position:absolute;
    top:50%;
    transform:translateY(-50%);
    width:12px;
    height:12px;
    border-radius:50%;
    background:#4b6b2f;
  }
  
  .timeline-bar::before{
    left:0;
  }
  
  .timeline-bar::after{
    left:50%;
  }
  
  /* dates */
  .timeline-dates{
    display:flex;
    justify-content:space-between;
    font-size:12px;
    color:#444;
  }
</style>

{% schema %}
{
  "name": "Cart Drawer",
  "target": "body",
  "javascript": "cart-drawer.js",
  "stylesheet": "cart-drawer.css",
  "settings": [
    {
      "type": "header",
      "content": "Layout & Colors"
    },
    {
      "type": "select",
      "id": "position",
      "label": "Drawer position",
      "options": [
        { "value": "right", "label": "Right" },
        { "value": "left", "label": "Left" }
      ],
      "default": "right"
    },
    {
      "type": "color",
      "id": "primary_color",
      "label": "Primary / button color",
      "default": "#111111"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Drawer background",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text color",
      "default": "#111111"
    },
    {
      "type": "text",
      "id": "announcement_text",
      "label": "Announcement bar text",
      "placeholder": "Free gift on orders over $75!"
    },
    {
      "type": "header",
      "content": "Progress Bar"
    },
    {
      "type": "checkbox",
      "id": "enable_progress_bar",
      "label": "Enable progress bar",
      "default": true
    },
    {
      "type": "number",
      "id": "tier1_threshold",
      "label": "Tier 1 — spend threshold ($)",
      "default": 50,
      "info": "Cart total needed to unlock this reward (e.g. 50 = $50)"
    },
    {
      "type": "text",
      "id": "tier1_label",
      "label": "Tier 1 — reward label",
      "default": "Free Shipping"
    },
    {
      "type": "checkbox",
      "id": "tier2_enabled",
      "label": "Enable tier 2",
      "default": false
    },
    {
      "type": "number",
      "id": "tier2_threshold",
      "label": "Tier 2 — spend threshold ($)",
      "default": 100
    },
    {
      "type": "text",
      "id": "tier2_label",
      "label": "Tier 2 — reward label",
      "default": "Free Gift"
    },
    {
      "type": "checkbox",
      "id": "tier3_enabled",
      "label": "Enable tier 3",
      "default": false
    },
    {
      "type": "number",
      "id": "tier3_threshold",
      "label": "Tier 3 — spend threshold ($)",
      "default": 150
    },
    {
      "type": "text",
      "id": "tier3_label",
      "label": "Tier 3 — reward label",
      "default": "10% Discount"
    },
    {
      "type": "checkbox",
      "id": "tier4_enabled",
      "label": "Enable tier 4",
      "default": false
    },
    {
      "type": "number",
      "id": "tier4_threshold",
      "label": "Tier 4 — spend threshold ($)",
      "default": 200
    },
    {
      "type": "text",
      "id": "tier4_label",
      "label": "Tier 4 — reward label",
      "default": "B2G2 FREE"
    },
    {
      "type": "checkbox",
      "id": "enable_upsell",
      "label": "Enable upsell recommendations",
      "default": true
    },
    {
      "type": "header",
      "content": "Gift Wrap"
    },
    {
      "type": "checkbox",
      "id": "enable_gift_wrap",
      "label": "Enable gift wrap option",
      "default": false
    },
    {
      "type": "text",
      "id": "gift_wrap_variant_id",
      "label": "Gift wrap product variant ID",
      "info": "Numeric variant ID from your store (e.g. 12345678901234)"
    },
    {
      "type": "text",
      "id": "gift_wrap_label",
      "label": "Gift wrap label",
      "default": "Add gift wrap"
    },
    {
      "type": "text",
      "id": "gift_wrap_price_label",
      "label": "Price label displayed next to toggle",
      "default": "FREE",
      "info": "Display only — actual price comes from the product variant"
    },
    {
      "type": "header",
      "content": "Estimated Shipping Timeline"
    },
    {
      "type": "checkbox",
      "id": "enable_delivery_timeline",
      "label": "Enable delivery timeline",
      "default": true
    },
    {
      "type": "number",
      "id": "timeline_fulfill_min",
      "label": "Shipping Min Days (e.g. 1)",
      "default": 1
    },
    {
      "type": "number",
      "id": "timeline_fulfill_max",
      "label": "Shipping Max Days (e.g. 2)",
      "default": 2
    },
    {
      "type": "number",
      "id": "timeline_delivery_min",
      "label": "Delivery Min Days (e.g. 3)",
      "default": 3
    },
    {
      "type": "number",
      "id": "timeline_delivery_max",
      "label": "Delivery Max Days (e.g. 5)",
      "default": 5
    },
    {
      "type": "header",
      "content": "Delivery Date Picker (Calendar)"
    },
    {
      "type": "checkbox",
      "id": "enable_delivery_date",
      "label": "Enable delivery date picker",
      "default": false
    },
    {
      "type": "text",
      "id": "delivery_date_label",
      "label": "Label",
      "default": "Choose delivery date"
    },
    {
      "type": "number",
      "id": "delivery_date_min_days",
      "label": "Minimum days from today",
      "default": 1
    },
    {
      "type": "number",
      "id": "delivery_date_max_days",
      "label": "Maximum days from today",
      "default": 30
    },
    {
      "type": "checkbox",
      "id": "enable_order_note",
      "label": "Enable handwritten note field",
      "default": false
    },
    {
      "type": "text",
      "id": "note_label",
      "label": "Label",
      "default": "Add a handwritten note"
    },
    {
      "type": "text",
      "id": "note_placeholder",
      "label": "Placeholder text",
      "default": "Write your personal message here..."
    },
    {
      "type": "header",
      "content": "Discount Code"
    },
    {
      "type": "checkbox",
      "id": "enable_discount",
      "label": "Enable discount code field",
      "default": true
    },
    {
      "type": "text",
      "id": "available_discounts",
      "label": "Available discount codes",
      "placeholder": "SAVE10:10% Off,FREESHIP:Free Shipping",
      "info": "Format: CODE:Label,CODE2:Label2 — shown as clickable chips above the input"
    }
  ]
}
{% endschema %}
