{% comment %}
  Cart Drawer — Theme App Extension Block
  All settings are read from the app admin panel via shop metafield: cart_drawer.settings
  Block schema has no settings — configure everything through the app.
{% endcomment %}

{% assign s = shop.metafields.cart_drawer.settings.value %}
{% assign u = shop.metafields.cart_drawer.upsell_products.value %}
{% assign dr = shop.metafields.cart_drawer.delivery_rules.value %}

<div id="tasslelife-cart-drawer-overlay" class="tasslelife-cart-drawer__overlay" aria-hidden="true"></div>

<div
  id="tasslelife-cart-drawer"
  class="tasslelife-cart-drawer tasslelife-cart-drawer--{% if s.drawerPosition %}{{ s.drawerPosition }}{% else %}right{% endif %}"
  role="dialog"
  aria-modal="true"
  aria-label="Shopping cart"
  data-currency="{{ cart.currency.iso_code }}"
  {{ block.shopify_attributes }}
>

  <!-- Header -->
  <div class="tasslelife-cart-drawer__header">
    <h2 class="tasslelife-cart-drawer__title">Your Cart (<span id="tasslelife-cart-drawer-count">0</span>)</h2>
    <button class="tasslelife-cart-drawer__close" data-tasslelife-cart-drawer-close aria-label="Close cart">
      <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <line x1="18" y1="6" x2="6" y2="18"></line><line x1="6" y1="6" x2="18" y2="18"></line>
      </svg>
    </button>
  </div>

  <!-- Announcement bar -->
  {% if s.announcementText != blank %}
  <div class="tasslelife-cart-drawer__announcement">{{ s.announcementText }}</div>
  {% endif %}

  <!-- Multi-tier Progress Bar -->
  {% if s.enableProgressBar != false and s.tier1Threshold > 0 %}
  <div
    id="tasslelife-cart-drawer-progress"
    class="tasslelife-cart-drawer__progress"
    data-tier1-threshold="{{ s.tier1Threshold }}"
    data-tier1-label="{{ s.tier1Label | default: 'Free Shipping' | escape }}"
    {% if s.tier2Enabled and s.tier2Threshold > 0 %}
    data-tier2-threshold="{{ s.tier2Threshold }}"
    data-tier2-label="{{ s.tier2Label | default: 'Free Gift' | escape }}"
    {% endif %}
    {% if s.tier3Enabled and s.tier3Threshold > 0 %}
    data-tier3-threshold="{{ s.tier3Threshold }}"
    data-tier3-label="{{ s.tier3Label | default: '10% Discount' | escape }}"
    {% endif %}
    {% if s.tier4Enabled and s.tier4Threshold > 0 %}
    data-tier4-threshold="{{ s.tier4Threshold }}"
    data-tier4-label="{{ s.tier4Label | default: '20% Discount' | escape }}"
    {% endif %}
  ></div>
  {% endif %}

  <!-- Scrollable body -->
  <div class="tasslelife-cart-drawer__body">

    <!-- Cart Items -->
    <div id="tasslelife-cart-drawer-items" class="tasslelife-cart-drawer__items">
      <div class="tasslelife-cart-drawer__loading"><div class="tasslelife-cart-drawer__spinner"></div></div>
    </div>

    <!-- Upsell -->
    {% if s.enableUpsell != false %}
    {% assign upsell_mode = u.mode | default: 'ai' %}
    {% assign show_atc = true %}
    {% if u.showAddToCart == false %}
      {% assign show_atc = false %}
    {% endif %}
    <div
      id="tasslelife-cart-drawer-upsell"
      class="tasslelife-cart-drawer__upsell"
      style="display:none;"
      data-upsell-mode="{{ upsell_mode }}"
      data-show-atc="{{ show_atc }}"
      {% if upsell_mode == 'collection' and u.collection != blank %}
      data-upsell-collection="{{ u.collection | escape }}"
      {% endif %}
    >
      <h3 class="tasslelife-cart-drawer__upsell-title">You might also like</h3>
      <div id="tasslelife-cart-drawer-upsell-items" class="tasslelife-cart-drawer__upsell-items"></div>
    </div>
    {% comment %} For manual mode: resolve product handles server-side and inject as JSON {% endcomment %}
    {% if upsell_mode == 'manual' and u.handles %}
      {% assign upsell_manual_items = '' %}
      {% assign upsell_manual_count = 0 %}
      {% for handle in u.handles %}
        {% if upsell_manual_count < 6 %}
          {% assign p = all_products[handle] %}
          {% if p.id > 0 %}
            {% if upsell_manual_count > 0 %}{% assign upsell_manual_items = upsell_manual_items | append: ',' %}{% endif %}
            {% capture pjson %}{"id":{{ p.id }},"title":{{ p.title | json }},"handle":{{ p.handle | json }},"url":{{ p.url | json }},"image":{% if p.featured_image %}{{ p.featured_image | image_url: width: 300 | json }}{% else %}null{% endif %},"price":{{ p.price }},"compare_price":{{ p.compare_at_price | default: 0 }},"variant_id":{{ p.first_available_variant.id }}}{% endcapture %}
            {% assign upsell_manual_items = upsell_manual_items | append: pjson %}
            {% assign upsell_manual_count = upsell_manual_count | plus: 1 %}
          {% endif %}
        {% endif %}
      {% endfor %}
      <script id="tasslelife-upsell-products" type="application/json">
        [{{ upsell_manual_items }}]
      </script>
    {% endif %}
    {% endif %}

    <!-- Gift Wrap -->
    {% if s.enableGiftWrap and s.giftWrapVariantId != blank %}
    <div class="tasslelife-cart-drawer__gift-wrap" data-variant-id="{{ s.giftWrapVariantId }}">
      <div class="tasslelife-cart-drawer__gift-wrap-inner">
        <div class="tasslelife-cart-drawer__gift-icon-box">
          <svg width="24" height="24" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
            <path d="M4 9H20V21C20 21.5523 19.5523 22 19 22H5C4.44772 22 4 21.5523 4 21V9Z" fill="#F43F5E"/>
            <path d="M3 6H21V9H3V6Z" fill="#E11D48"/>
            <path d="M11 6V22H13V6H11Z" fill="#9F1239"/>
            <path d="M12 6C12 6 9 2 6.5 2C4.567 2 3 3.567 3 5.5C3 7 7 6 12 6Z" fill="#F43F5E" stroke="#9F1239" stroke-width="1.5"/>
            <path d="M12 6C12 6 15 2 17.5 2C19.433 2 21 3.567 21 5.5C21 7 17 6 12 6Z" fill="#F43F5E" stroke="#9F1239" stroke-width="1.5"/>
          </svg>
        </div>
        <div class="tasslelife-cart-drawer__gift-text">
          <p class="tasslelife-cart-drawer__gift-title">{{ s.giftWrapLabel | default: 'Gift Wrap this Order' }}</p>
          <p class="tasslelife-cart-drawer__gift-price">{{ s.giftWrapPriceLabel | default: '₹100' }}</p>
        </div>
        <button class="tasslelife-cart-drawer__gift-btn" id="tasslelife-cart-drawer-gift-wrap">+ Add</button>
      </div>
    </div>
    {% endif %}



    <!-- Handwritten Note -->
    {% if s.enableOrderNote %}
    <div class="tasslelife-cart-drawer__section">
      <label class="tasslelife-cart-drawer__section-label" for="tasslelife-cart-drawer-note">
        <span>✏️</span> {{ s.noteLabel | default: 'Add a handwritten note' }}
      </label>
      <textarea
        id="tasslelife-cart-drawer-note"
        class="tasslelife-cart-drawer__note-textarea"
        placeholder="{{ s.notePlaceholder | default: 'Write your personal message here...' | escape }}"
        maxlength="500"
        rows="3"
        aria-label="{{ s.noteLabel | default: 'Add a handwritten note' }}"
      ></textarea>
      <p class="tasslelife-cart-drawer__note-counter"><span id="tasslelife-cart-drawer-note-count">0</span>/500</p>
    </div>
    {% endif %}

    <!-- Coupons Section -->
    {% if s.enableDiscount != false %}
    <div class="tasslelife-cart-drawer__section">
      <div class="tasslelife-cart-drawer__coupons-compact" id="tasslelife-cart-drawer-coupons-compact">
        <div class="tasslelife-cart-drawer__coupons-compact-top">
          <div class="tasslelife-cart-drawer__coupons-compact-left">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg"><path d="M20.59 13.41l-7.17 7.17a2 2 0 0 1-2.83 0L2 12V2h10l8.59 8.59a2 2 0 0 1 0 2.82z" stroke="#166534" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/><line x1="7" y1="7" x2="7.01" y2="7" stroke="#166534" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>
            <div class="tasslelife-cart-drawer__coupons-compact-text">
              <strong id="tasslelife-cart-drawer-best-savings">Save ₹0</strong>
              <small id="tasslelife-cart-drawer-best-code">with ''</small>
            </div>
          </div>
          <button class="tasslelife-cart-drawer__coupons-compact-apply">Apply</button>
        </div>
        <div class="tasslelife-cart-drawer__coupons-compact-bottom" id="tasslelife-cart-drawer-coupons-view-all">
          <div class="tasslelife-cart-drawer__coupons-compact-left">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg"><path d="M20.59 13.41l-7.17 7.17a2 2 0 0 1-2.83 0L2 12V2h10l8.59 8.59a2 2 0 0 1 0 2.82z" stroke="#166534" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/><line x1="7" y1="7" x2="7.01" y2="7" stroke="#166534" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>
            <span><span id="tasslelife-cart-drawer-more-count">0</span> more offers</span>
          </div>
          <span class="tasslelife-cart-drawer__coupons-compact-link">View all coupons ></span>
        </div>
      </div>
      
      <!-- Manual Input Fallback -->
      <div class="tasslelife-cart-drawer__discount-row" id="tasslelife-cart-drawer-discount-manual" style="display:none; margin-top: 10px;">
        <input type="text" id="tasslelife-cart-drawer-discount-input" class="tasslelife-cart-drawer__discount-input" placeholder="Discount code" autocapitalize="characters" autocomplete="off" spellcheck="false">
        <button id="tasslelife-cart-drawer-discount-apply" class="tasslelife-cart-drawer__discount-btn">Apply</button>
      </div>
      <p id="tasslelife-cart-drawer-discount-msg" class="tasslelife-cart-drawer__discount-msg"></p>
    </div>

    <!-- Coupons Data -->
    <script id="tasslelife-coupons-data" type="application/json">
      {% if s.coupons %}{{ s.coupons | json }}{% else %}[{"code":"FAB10","type":"percentage","value":10,"minThreshold":1499},{"code":"FAB5","type":"percentage","value":5,"minThreshold":999},{"code":"FAB15","type":"percentage","value":15,"minThreshold":3999}]{% endif %}
    </script>
    {% endif %}

    <!-- Per-product delivery dates map (built from collection metafields std_min / std_max) -->
    {% if s.enableItemDeliveryDate %}
    <script id="tasslelife-delivery-dates-map" type="application/json">
    {
      {%- assign _dd_sep = "" -%}
      {%- comment -%}--- Cart items already in cart at page load ---{%- endcomment -%}
      {%- for item in cart.items -%}
        {%- assign _dd_min = 9999 -%}
        {%- assign _dd_max = 9999 -%}
        {%- assign _dd_found = false -%}
        {%- for col in item.product.collections -%}
          {%- assign _col_min = col.metafields.custom.std_min.value | plus: 0 -%}
          {%- assign _col_max = col.metafields.custom.std_max.value | plus: 0 -%}
          {%- if _col_min > 0 and _col_min < _dd_min -%}
            {%- assign _dd_min = _col_min -%}
            {%- assign _dd_max = _col_max -%}
            {%- assign _dd_found = true -%}
          {%- endif -%}
        {%- endfor -%}
        {%- if _dd_found -%}
          {{ _dd_sep }}"{{ item.product_id }}": { "stdMin": {{ _dd_min }}, "stdMax": {{ _dd_max }} }
          {%- assign _dd_sep = "," -%}
        {%- endif -%}
      {%- endfor -%}
      {%- comment -%}--- Current product page (so ATC → open drawer shows dates immediately) ---{%- endcomment -%}
      {%- if product.id -%}
        {%- assign _dd_min = 9999 -%}
        {%- assign _dd_max = 9999 -%}
        {%- assign _dd_found = false -%}
        {%- for col in product.collections -%}
          {%- assign _col_min = col.metafields.custom.std_min.value | plus: 0 -%}
          {%- assign _col_max = col.metafields.custom.std_max.value | plus: 0 -%}
          {%- if _col_min > 0 and _col_min < _dd_min -%}
            {%- assign _dd_min = _col_min -%}
            {%- assign _dd_max = _col_max -%}
            {%- assign _dd_found = true -%}
          {%- endif -%}
        {%- endfor -%}
        {%- if _dd_found -%}
          {{ _dd_sep }}"{{ product.id }}": { "stdMin": {{ _dd_min }}, "stdMax": {{ _dd_max }} }
          {%- assign _dd_sep = "," -%}
        {%- endif -%}
      {%- endif -%}
    }
    </script>
    {% endif %}

    <!-- Delivery Timeline -->
    {% if s.enableDeliveryTimeline != false %}

    {% comment %} Determine date window: collection rules override settings defaults {% endcomment %}
    {% assign tl_fulfill_min = s.timelineFulfillMin | default: 4 %}
    {% assign tl_fulfill_max = s.timelineFulfillMax | default: 5 %}
    {% assign tl_delivery_min = s.timelineDeliveryMin | default: 10 %}
    {% assign tl_delivery_max = s.timelineDeliveryMax | default: 11 %}

    {% if dr.rules %}
      {% assign tl_rule_found = false %}
      {% for item in cart.items %}
        {% unless tl_rule_found %}
          {% for collection in item.product.collections %}
            {% unless tl_rule_found %}
              {% for rule in dr.rules %}
                {% if rule.collection == collection.handle %}
                  {% assign tl_fulfill_min = rule.fulfillMin %}
                  {% assign tl_fulfill_max = rule.fulfillMax %}
                  {% assign tl_delivery_min = rule.deliveryMin %}
                  {% assign tl_delivery_max = rule.deliveryMax %}
                  {% assign tl_rule_found = true %}
                {% endif %}
              {% endfor %}
            {% endunless %}
          {% endfor %}
        {% endunless %}
      {% endfor %}
    {% endif %}

    <div class="tasslelife-cart-drawer__timeline-container" id="tasslelife-cart-drawer-timeline"
         data-fulfill-min="{{ tl_fulfill_min }}"
         data-fulfill-max="{{ tl_fulfill_max }}"
         data-delivery-min="{{ tl_delivery_min }}"
         data-delivery-max="{{ tl_delivery_max }}">
      <div class="tasslelife-cart-drawer__timeline-item">
        <div class="tasslelife-cart-drawer__timeline-icon">🤲🪙</div>
        <p class="tasslelife-cart-drawer__timeline-date" id="tasslelife-cart-drawer-timeline-today"></p>
        <p class="tasslelife-cart-drawer__timeline-title">Order Received</p>
      </div>
      <div class="tasslelife-cart-drawer__timeline-connector">
        <div class="tasslelife-cart-drawer__timeline-line"></div>
        <p class="tasslelife-cart-drawer__timeline-text">We're on It!</p>
      </div>
      <div class="tasslelife-cart-drawer__timeline-item">
        <div class="tasslelife-cart-drawer__timeline-icon">🚚</div>
        <p class="tasslelife-cart-drawer__timeline-date" id="tasslelife-cart-drawer-timeline-fulfill"></p>
        <p class="tasslelife-cart-drawer__timeline-title">Order Fulfilled</p>
      </div>
      <div class="tasslelife-cart-drawer__timeline-connector">
        <div class="tasslelife-cart-drawer__timeline-line"></div>
        <p class="tasslelife-cart-drawer__timeline-text">On the Way!</p>
      </div>
      <div class="tasslelife-cart-drawer__timeline-item">
        <div class="tasslelife-cart-drawer__timeline-icon">🏪</div>
        <p class="tasslelife-cart-drawer__timeline-date" id="tasslelife-cart-drawer-timeline-deliver"></p>
        <p class="tasslelife-cart-drawer__timeline-title">Delivered to Your<br>Door</p>
      </div>
    </div>
    {% endif %}

  </div>

  <!-- Footer -->
  <div class="tasslelife-cart-drawer__footer" id="tasslelife-cart-drawer-footer" style="display:none;">
    <div class="tasslelife-cart-drawer__subtotal-row">
      <span class="tasslelife-cart-drawer__subtotal-label">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#666" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="vertical-align: middle; margin-right: 6px;"><rect x="3" y="11" width="18" height="10" rx="2"/><circle cx="12" cy="5" r="2"/><path d="M12 7v4"/><line x1="8" y1="16" x2="8" y2="16"/><line x1="16" y1="16" x2="16" y2="16"/></svg>
        Estimated total
      </span>
      <span class="tasslelife-cart-drawer__subtotal-value" id="tasslelife-cart-drawer-subtotal">—</span>
    </div>
    <div class="tasslelife-cart-drawer__actions">
      <a href="/checkout" class="tasslelife-cart-drawer__checkout-btn" id="tasslelife-cart-drawer-checkout">
        <span class="tasslelife-cart-drawer__checkout-text">Checkout</span>
        <span class="tasslelife-cart-drawer__checkout-icons">
          <img src="https://cdn.shopify.com/s/files/1/0819/2711/0950/files/payment-icons.png?v=1714493394" alt="Payment icons" width="200" height="24" style="height: 24px; width: auto;">
        </span>
      </a>
    </div>
  </div>

</div>

<!-- Coupons Modal Overlay -->
<div id="tasslelife-cart-drawer-coupons-overlay" class="tasslelife-cart-drawer__overlay" aria-hidden="true" style="z-index:99999;"></div>

<!-- Coupons Modal -->
<div id="tasslelife-cart-drawer-coupons-modal" class="tasslelife-cart-drawer__coupons-modal" aria-hidden="true">
  <div class="tasslelife-cart-drawer__coupons-modal-header">
    <button class="tasslelife-cart-drawer__coupons-modal-back" aria-label="Back">
      <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="#111" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="19" y1="12" x2="5" y2="12"></line><polyline points="12 19 5 12 12 5"></polyline></svg>
    </button>
    <h3 class="tasslelife-cart-drawer__coupons-modal-title">Apply Coupon</h3>
  </div>
  <div class="tasslelife-cart-drawer__coupons-modal-body">
    <h4 class="tasslelife-cart-drawer__coupons-list-title">AVAILABLE COUPONS</h4>
    <div id="tasslelife-cart-drawer-available-coupons"></div>

    <h4 class="tasslelife-cart-drawer__coupons-list-title" style="margin-top:20px;">UNAVAILABLE COUPONS</h4>
    <div id="tasslelife-cart-drawer-unavailable-coupons"></div>
  </div>
</div>

<style>
  :root {
    --tasslelife-cart-drawer-primary: {{ s.primaryColor | default: '#111111' }};
    --tasslelife-cart-drawer-bg: {{ s.backgroundColor | default: '#ffffff' }};
    --tasslelife-cart-drawer-text: {{ s.textColor | default: '#111111' }};
    --tasslelife-cart-drawer-width: 420px;
  }
</style>

{% schema %}
{
  "name": "Cart Drawer",
  "target": "body",
  "javascript": "cart-drawer.js",
  "stylesheet": "cart-drawer.css",
  "settings": []
}
{% endschema %}
